# DEEPGUARD AI configuration. Copy to .env (never commit .env).
# Only variables you want to change need to be set; defaults are shown.

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# development | production  (production hides /api/docs, adds HSTS, deletes uploads after analysis)
ENVIRONMENT=development
# Optional shared secret. When set, clients must send the header  X-API-Key: <value>
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated allowed origins. "*" = any origin (no credentialed CORS). Set your real origin in production.
CORS_ORIGINS=*
# Comma-separated Host headers to accept. Empty = no host check.
TRUSTED_HOSTS=
# Honour X-Forwarded-For only when running behind a reverse proxy you control.
TRUST_PROXY=false
ENABLE_DOCS=true
DELETE_UPLOAD_AFTER=false

# --- jobs / Redis (the app falls back to an in-process queue if Redis is down) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# --- model ------------------------------------------------------------------
# resnext50 | efficientnet_b3 | resnet18
BACKBONE=resnext50
# cpu | cuda | auto
DEVICE=cpu
SEQ_LEN=32
WEIGHTS_PATH=weights/deepfake_detector.pth
# Set to 0 to avoid downloading ImageNet backbone weights (offline use; demo mode only).
PRETRAINED_BACKBONE=1
SPATIAL_BATCH=4
TORCH_THREADS=1
# DANGER: allows unsafe pickle checkpoints. Leave false unless you made the file yourself.
DEEPGUARD_ALLOW_PICKLE=false

# --- limits -----------------------------------------------------------------
MAX_UPLOAD_MB=120
MAX_VIDEO_SECONDS=180
MAX_VIDEO_PIXELS=16777216
MAX_DECODE_FRAMES=14400
DETECT_RATE=12
SAMPLE_RATE=6
STATUS_RATE=120
